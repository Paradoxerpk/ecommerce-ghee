# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL / Supabase URL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# JWT Secret for Auth sessions
JWT_SECRET=your_super_secret_session_token_key_here

# Mock Razorpay Credentials for Demo (or replace with live keys)
RAZORPAY_KEY_ID=rzp_test_mockkeyid12345
RAZORPAY_KEY_SECRET=mockkeysecret67890
